# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./dzeline.db

# ── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,https://dzeline.online

# ── Safaricom Daraja (M-Pesa) ────────────────────────────────────────────────
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey
MPESA_SHORTCODE_TYPE=paybill
MPESA_CALLBACK_URL=https://dzeline.online/api/mpesa/callback

# ── SMS Gateway (android-sms-gateway on shop device) ─────────────────────────
SMS_WEBHOOK_SECRET=change_me_to_a_random_string

# ── KRA eTIMS ────────────────────────────────────────────────────────────────
ETIMS_ENV=sandbox
ETIMS_TIN=P051234567X
ETIMS_BHF_ID=00
ETIMS_DEVICE_SERIAL=VSCU00000001
