# Copy this file to .env and fill in real values

# Database — leave as-is for SQLite
DATABASE_URL=sqlite:///./dzeline.db

# Daraja M-Pesa API credentials
# Register at https://developer.safaricom.co.ke/
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey_here
MPESA_CALLBACK_URL=https://dzeline.online/api/mpesa/callback
MPESA_ENV=sandbox

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,https://dzeline.online
