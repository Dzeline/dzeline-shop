<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ── Header ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1E1B4B"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forwards M-Pesa SMS to Dzeline POS backend"
            android:textSize="13sp"
            android:textColor="#6B7280"
            android:layout_marginBottom="20dp" />

        <!-- ── Notification access status ── -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checking…"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNotificationAccess"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Open Notification Access Settings"
            android:textSize="13sp"
            app:backgroundTint="#6366F1"
            android:layout_marginBottom="28dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>

        <!-- ── Webhook URL ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Backend Webhook URL"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#374151"
            android:letterSpacing="0.08"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etWebhookUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://dzeline-api.onrender.com/sms/webhook"
            android:inputType="textUri"
            android:textSize="13sp"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:singleLine="true"
            android:layout_marginBottom="18dp" />

        <!-- ── Secret ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Webhook Secret  (X-SMS-Secret)"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#374151"
            android:letterSpacing="0.08"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etSecret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Paste your SMS_WEBHOOK_SECRET here"
            android:inputType="textPassword"
            android:textSize="13sp"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <!-- ── Action buttons ── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Save Settings"
            app:backgroundTint="#2563EB"
            android:layout_marginBottom="10dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Send Test Webhook"
            app:backgroundTint="#059669"
            android:layout_marginBottom="28dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This app runs silently in the background. Do not uninstall it. Keep notification access enabled."
            android:textSize="11sp"
            android:textColor="#9CA3AF"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>
</ScrollView>
